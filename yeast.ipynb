    subprocess.run(["wget", "-q", "-O", str(model_json),
        f"{base_url}/{VOICE_MODEL}.onnx.json"], check=True)
    print("✅ Voice model downloaded.")

print("Generating synthetic positive samples…")
# Generate multiple phrasing variations
variations = [PHONETICS] * 5  # Extend with pitch/speed variants in Step 8
for i, phrase in enumerate(variations):
    out_path = POSITIVE_DIR / f"synth_{i:04d}.wav"
