def phonetic_from_recording(b64_audio):
    webm = "/content/ph_ref.webm"
    wav  = "/content/ph_ref.wav"
    with open(webm, "wb") as f:
        f.write(base64.b64decode(b64_audio))
    subprocess.run(
        ["ffmpeg", "-y", "-i", webm, "-ar", "16000", "-ac", "1", wav],
        capture_output=True
    )
    try:
        import whisper
    except ImportError:
        subprocess.run(["pip", "install", "-q", "openai-whisper"], check=True)
        import whisper

    model = whisper.load_model("tiny")
    heard = model.transcribe(wav)["text"].strip()

    ipa = subprocess.run(
        ["espeak-ng", "--ipa", "-q", heard],
        capture_output=True, text=True
    ).stdout.strip()

    # Auto-fill the widget
    phonetic_input.value = ipa

    display(HTML(f"""
    <div style="margin-top:8px; font-size:13px; padding:8px;
                background:#f0f7ff; border-left:3px solid #4a90d9; border-radius:4px;">
      ✅ <b>Heard:</b> "{heard}"<br>
      ✅ <b>Phonetics set to:</b> <code>{ipa}</code><br>
      <span style="color:#888">Edit the Phonetics field above if anything looks off.</span>
    </div>
    """))

output.register_callback('phonetic_from_recording', phonetic_from_recording)

