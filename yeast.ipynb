# ════════════════════════════════════════════════════════
# STEP 9 — Build Dataset
# ════════════════════════════════════════════════════════
import shutil
from audiomentations import Compose, AddGaussianNoise, RoomSimulator, PitchShift
import numpy as np
import soundfile as sf

NUM_SAMPLES  = num_samples_slider.value
DATASET_DIR  = Path(f"/content/datasets/{WAKE_WORD}")
FINAL_POS    = DATASET_DIR / "positive"
FINAL_NEG    = DATASET_DIR / "negative_linked"
FINAL_POS.mkdir(parents=True, exist_ok=True)

augment = Compose([
    AddGaussianNoise(min_amplitude=0.001, max_amplitude=0.015,
                     p=noise_prob.value),
    PitchShift(min_semitones=-pitch_shift.value,
               max_semitones=pitch_shift.value, p=0.5),
])

# Gather source positive files (synthetic + voice)
synth_files = list(POSITIVE_DIR.glob("*.wav"))
voice_files = list(VOICE_DIR.glob("*.wav")) if VOICE_DIR.exists() else []
all_sources = synth_files + voice_files

print(f"Source files: {len(synth_files)} synthetic + {len(voice_files)} voice = {len(all_sources)} total")
print(f"Generating {NUM_SAMPLES} augmented positive samples…")

for i in range(NUM_SAMPLES):
    src = all_sources[i % len(all_sources)]
    audio, sr = sf.read(str(src))
    if audio.ndim > 1:
        audio = audio.mean(axis=1)
    audio = augment(samples=audio.astype(np.float32), sample_rate=sr)
    sf.write(str(FINAL_POS / f"pos_{i:05d}.wav"), audio, sr)

print(f"✅ {NUM_SAMPLES} positive samples written → {FINAL_POS}")

# Symlink negative dir
if FINAL_NEG.exists():
    FINAL_NEG.unlink()
FINAL_NEG.symlink_to(NEG_DIR)
print(f"✅ Negative samples linked → {FINAL_NEG}")

