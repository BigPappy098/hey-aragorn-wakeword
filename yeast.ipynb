def save_voice_sample(b64_audio, index):
    webm = f"/content/voice_tmp_{index}.webm"
    wav  = VOICE_DIR / f"voice_{index:04d}.wav"
    with open(webm, "wb") as f:
        f.write(base64.b64decode(b64_audio))
    subprocess.run(
        ["ffmpeg", "-y", "-i", webm, "-ar", "16000", "-ac", "1", str(wav)],
        capture_output=True
    )
    os.remove(webm)
    recorded_clips.append(str(wav))

colab_output.register_callback('save_voice_sample', save_voice_sample)

