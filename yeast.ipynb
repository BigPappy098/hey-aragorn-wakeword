print(f"Wake word  : {WAKE_WORD}")
print(f"Phonetics  : {PHONETICS}")
print(f"Voice model: {VOICE_MODEL}")

# Download Piper binary
PIPER_DIR = Path("/content/piper")
if not (PIPER_DIR / "piper").exists():
    print("Downloading Piper…")
    subprocess.run([
        "wget", "-q", "-O", "/content/piper.tar.gz",
        "https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz"
    ], check=True)
    subprocess.run(["tar", "-xf", "/content/piper.tar.gz", "-C", "/content/"], check=True)
    print("✅ Piper downloaded.")

# Download voice model
MODEL_DIR = Path(f"/content/piper_voices/{VOICE_MODEL}")
MODEL_DIR.mkdir(parents=True, exist_ok=True)
model_onnx = MODEL_DIR / f"{VOICE_MODEL}.onnx"
model_json = MODEL_DIR / f"{VOICE_MODEL}.onnx.json"

if not model_onnx.exists():
    print(f"Downloading voice model {VOICE_MODEL}…")
