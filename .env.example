# Copy this file to .env and fill in your values.
# RunPod users: these are set in the pod config UI — you don't need this file.

# Working directory for training data, models, and repos
# (RunPod default: /workspace/training)
WORK_DIR=~/wakeword-training

# GitHub repo (owner/name) for pushing trained models
GITHUB_REPO=

# GitHub personal access token (with repo scope)
GITHUB_TOKEN=
